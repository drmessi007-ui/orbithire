# OrbitHire agent configuration template.
# Copy to secrets/.env (repo root) or provide the same variables through the
# environment / your host's secret manager. Never commit the real file.

# --- NEAR (testnet only; the agent refuses to start on another network) ---
NEAR_NETWORK_ID=testnet
NEAR_RPC_URL=https://rpc.testnet.near.org
ORBIT_HIRE_CONTRACT_ID=orbit-hire.shortemail369.testnet
# Must be the agent_id configured in the contract (only it can submit receipts).
AGENT_ACCOUNT_ID=your-agent-account.testnet
# The AGENT account's own key ("ed25519:..."). Never the owner key. Keep secret.
AGENT_PRIVATE_KEY=

# --- Optional prompt-injection guard (TypeSafe Jev). Empty = simulation mode,
# which is NOT a security control. ---
JEV_API_KEY=
JEV_MODEL=jev-1.14.0

# --- Optional NEAR AI Cloud (https://cloud.near.ai, OpenAI-compatible API) ---
# The LLM only classifies the question into an allow-listed intent and rewrites
# already-computed facts as prose. Empty key, no credits, timeout or invalid
# output = deterministic regex classifier + template report. Keep the key secret.
NEARAI_API_KEY=
NEARAI_BASE_URL=https://cloud-api.near.ai/v1
NEARAI_MODEL=Qwen/Qwen3-VL-30B-A3B-Instruct
NEARAI_TIMEOUT_MS=20000
NEARAI_MAX_TOKENS=500

# --- Optional second LLM provider: OpenAI (used only if NEAR AI Cloud fails) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_MS=15000
OPENAI_MAX_TOKENS=500

# --- HTTP API ---
SERVICE_HOST=127.0.0.1
SERVICE_PORT=8787
# Exact HTTPS origin serving the frontend (no path). CORS and /api/notify accept only this origin.
FRONTEND_ORIGIN=https://drmessi007-ui.github.io

# --- Block scanner / state sweep ---
POLL_INTERVAL_MS=60000
# Optional first block to scan; empty = latest 100 blocks on first run.
START_BLOCK_HEIGHT=
SCAN_RPC_URL=https://rpc.testnet.fastnear.com
SCAN_MAX_RPS=2
SCAN_MAX_BLOCKS_PER_TICK=60
SCAN_CONCURRENCY=6
SCAN_CATCHUP_INTERVAL_MS=2000
SCAN_MAX_BACKOFF_MS=300000
SCAN_TX_SEARCH_WINDOW=6
SCAN_STATE_SWEEP_INTERVAL_MS=30000
